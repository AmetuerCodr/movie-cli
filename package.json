{
  "name": "mov-cli",
  "version": "0.2.0",
  "description": "Watch movies from the terminal — ani-cli for movies",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mov-cli": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --format esm --sourcemap --external playwright --external playwright-core --external chromium-bidi",
    "build:bun": "bun build src/index.ts --outdir dist --target bun --format esm --external playwright --external playwright-core --external chromium-bidi",
    "prepublishOnly": "bun run build",
    "lint": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@cliqz/adblocker-playwright": "^1.28.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "cross-spawn": "^7.0.3",
    "inquirer": "^10.0.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.0.1",
    "playwright": "^1.44.0",
    "undici": "^6.19.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.32",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  },
  "keywords": [
    "cli",
    "movies",
    "streaming",
    "terminal",
    "ani-cli"
  ]
}
