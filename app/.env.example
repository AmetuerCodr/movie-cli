# Base URL of your Supabase edge functions.
# Find it at: https://<project-ref>.supabase.co/functions/v1
# (Settings -> API in the Supabase dashboard.)
EXPO_PUBLIC_API_BASE=https://YOUR_PROJECT_REF.supabase.co/functions/v1

# Your Supabase anon key (sent as the apikey/authorization header).
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
